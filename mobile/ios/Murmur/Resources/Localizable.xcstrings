    "home.emptyText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur transcriu mentre parleu i separa qui diu què. Tot es queda al telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur transcribe mientras habláis y separa quién dice qué. Todo se queda en el teléfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur transcribes as you talk and tells who says what. Everything stays on your phone."
          }
        }
      }
    },
