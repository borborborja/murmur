    "settings.computerSoon": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectar amb l'ordinador arribarà aviat: les reunions hi passaran per refer-les amb Whisper i fer-ne el resum."
          }
