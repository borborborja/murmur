    "meeting.sent": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja és a l'ordinador, que la tornarà a escoltar amb Whisper. Quan acabi, la versió revisada arribarà aquí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en el ordenador, que la volverá a escuchar con Whisper. Cuando acabe, la versión revisada llegará aquí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's on the computer now, which will listen to it again with Whisper. When it's done, the revised version will arrive here."
          }
        }
      }
    },
