    "meeting.pending": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan el telèfon trobi l'ordinador, hi afegirà el títol, el resum i la passada de Whisper. Ara és la transcripció ràpida."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el teléfono encuentre el ordenador, añadirá el título, el resumen y la pasada de Whisper. Ahora es la transcripción rápida."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the phone finds your computer, it will add the title, the summary and the Whisper pass. For now this is the quick transcript."
          }
        }
      }
    },
