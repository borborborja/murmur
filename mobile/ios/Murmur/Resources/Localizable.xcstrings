    "pair.after": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després, cada reunió que facis amb el mòbil passarà a l'ordinador quan siguin a la mateixa xarxa, xifrada. L'ordinador la tornarà a escoltar i et tornarà el resum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, cada reunión que hagas con el móvil pasará al ordenador cuando estén en la misma red, cifrada. El ordenador la volverá a escuchar y te devolverá el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then every meeting you record on the phone goes to the computer, encrypted, when both are on the same network. The computer listens to it again and sends you back the summary."
          }
        }
      }
    },
