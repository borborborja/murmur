    },
    "settings.computerHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reunions hi passaran soles quan siguin a la mateixa xarxa: l'ordinador les torna a escoltar amb Whisper i en fa el resum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones pasarán solas cuando estén en la misma red: el ordenador las vuelve a escuchar con Whisper y hace el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings go to it on their own when both are on the same network: the computer listens to them again with Whisper and writes the summary."
          }
        }
      }
    },
