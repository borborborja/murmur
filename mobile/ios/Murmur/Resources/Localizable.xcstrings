        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con el ordenador llegará pronto: las reuniones pasarán a él para rehacerlas con Whisper y hacer el resumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to your computer is coming soon: meetings will go there to be redone with Whisper and summarised."
          }
        }
      }
