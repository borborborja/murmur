    "settings.micHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Automàtic fa servir el micròfon connectat per cable o USB i, si no n'hi ha, el de l'iPhone. Els auriculars Bluetooth només si els tries: només senten qui els porta, no la sala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa el micrófono conectado por cable o USB y, si no hay, el del iPhone. Los auriculares Bluetooth solo si los eliges: solo oyen a quien los lleva, no la sala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses a wired or USB microphone if there is one, otherwise the iPhone's. Bluetooth headphones only if you pick them: they only hear whoever is wearing them, not the room."
          }
        }
      }
    },
